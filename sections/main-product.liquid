{{ 'popup-modal.css' | asset_url | stylesheet_tag }}
<div
        class="product-template__container container page-width pt-4"
        id="ProductSection-{{ section.id }}"
        data-section-id="{{ section.id }}"
        data-section-type="product-template"
        data-enable-history-state="true"
        data-ajax-enabled="{{ settings.enable_ajax }}"
>
    <div class="mb-2">
        {% render 'breadcrumb' %}
    </div>
    {% liquid
        assign current_variant = product.selected_or_first_available_variant
    %}
    {% liquid
        case section.settings.media_size
            when 'small'
                assign product_media_width = 'col-12 col-md-5'
                assign product_description_width = 'col-12 col-md-7'
            when 'medium'
                assign product_media_width = 'col-12 col-md-6'
                assign product_description_width = 'col-12 col-md-6'
            when 'large'
                assign product_media_width = 'col-12 col-md-7'
                assign product_description_width = 'col-12 col-md-5'
            when 'x-large'
                assign product_media_width = 'col-12 col-md-8'
                assign product_description_width = 'col-12 col-md-4'
            when 'full'
                assign product_media_width = 'col-12'
                assign product_description_width = 'col-12 col-md-10'
        endcase
    %}
    <div class="row gx-3 gx-lg-5">
        {% if section.settings.enable_collection_list %}
            <div class="col-12 col-lg-2 d-none d-lg-block">
                <ul class="list-unstyled sticky-top top-10">
                    {% for collection in section.settings.collection_list %}
                        <li>
                            <a
                                    class="hover-change-icon d-flex align-items-center justify-content-between fs-18 fw-bold py-2"
                                    href="{{ collection.url }}"
                                    aria-label="{{ collection.title }}"
                            >
                                {{ collection.title }}
                                <i class="bi bi-chevron-right ms-3 fs-14"></i>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
        <div class="col-12 {% if section.settings.enable_collection_list %}col-lg-10{% endif %}">
            <div class="row gx-4 gx-custom-lg-6 product-single{% if section.settings.enable_payment_button %} product-single--{{ section.settings.media_size }}-media{% endif %}{% if section.settings.media_right %} flex-column flex-md-row-reverse{% endif %}">
                <div
                        class="col product-single__media-group {{ product_media_width }} position-relative mb-3 mb-lg-0"
                        data-product-single-media-group
                >
                    {% liquid
                        case section.settings.media_style
                            when 'thumbs_horizontal'
                                assign media_render = 'single-product-1'
                                assign media_style = ''
                            when 'thumbs_vertical'
                                assign media_render = 'single-product-1'
                                assign media_style = 'style-vertical'
                            when '1_column'
                                assign media_render = 'single-product-2'
                                assign media_style = '1'
                            when '2_columns'
                                assign media_render = 'single-product-2'
                                assign media_style = '2'
                            when '3_columns'
                                assign media_render = 'single-product-2'
                                assign media_style = '3'
                            when 'mix_columns'
                                assign media_render = 'single-product-2'
                                assign media_style = '1-2-3'
                            when 'sticky_columns'
                                assign media_render = 'single-product-3'
                                assign media_style = 'sticky'
                        endcase
                    %}
                    <div class="sticky-md-top top-10">
                        {% case media_render %}
                           {%  when 'single-product-1' %}
                               {% render 'single-product-1',
                                       product: product,
                                       section_id: section.id,
                                       style: media_style,
                                       enable_image_zoom: section.settings.enable_image_zoom,
                                       enable_video_looping: section.settings.enable_video_looping
                               %}
                            {%  when 'single-product-3' %}
                            {% render 'single-product-3',
                                    product: product,
                                    section_id: section.id,
                                    style: media_style,
                                    enable_image_zoom: section.settings.enable_image_zoom,
                                    enable_video_looping: section.settings.enable_video_looping
                            %}
                            {%  else %}
                            {% render 'single-product-2',
                                    product: product,
                                    section_id: section.id,
                                    style: media_style,
                                    enable_image_zoom: section.settings.enable_image_zoom,
                                    enable_video_looping: section.settings.enable_video_looping
                            %}
                        {% endcase %}
                        <div class="content-description-more">
                            {% for block in section.blocks %}
                                {% case block.type %}
                                    {% when 'collapsible-row' %}
                                        {% if block.settings.style == 'style-2' %}
                                            <div
                                                    class="accordion style-1 mb-{{ block.settings.margin_bottom }} mt-5 d-none d-md-block"
                                                    id="accordion-{{ block.id }}"
                                                    {{ block.shopify_attributes }}
                                            >
                                                {% if block.settings.heading1 != blank %}
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button text-uppercase collapsed fs-15"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseOne"
                                                                    aria-expanded="true"
                                                                    aria-controls="collapseOne">
                                                                {{ block.settings.heading1 | default: block.settings.page.title1 }}
                                                            </button>
                                                        </h2>
                                                        <div id="collapseOne"
                                                             class="accordion-collapse collapse show"
                                                             data-bs-parent="#accordion-{{ block.id }}">
                                                            <div class="accordion-body rte rte-custom">
                                                                {{ block.settings.row_content1 }}
                                                                {{ block.settings.page.content1 }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if block.settings.heading2 != blank %}
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button text-uppercase collapsed fs-15"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseTwo"
                                                                    aria-expanded="true"
                                                                    aria-controls="collapseTwo">
                                                                {{ block.settings.heading2 | default: block.settings.page.title2 }}
                                                            </button>
                                                        </h2>
                                                        <div id="collapseTwo"
                                                             class="accordion-collapse collapse"
                                                             data-bs-parent="#accordion-{{ block.id }}">
                                                            <div class="accordion-body rte rte-custom">
                                                                {{ block.settings.row_content2 }}
                                                                {{ block.settings.page.content2 }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if block.settings.heading3 != blank %}
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button text-uppercase collapsed fs-15"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseThree"
                                                                    aria-expanded="true"
                                                                    aria-controls="collapseThree">
                                                                {{ block.settings.heading3 | default: block.settings.page.title3 }}
                                                            </button>
                                                        </h2>
                                                        <div id="collapseThree"
                                                             class="accordion-collapse collapse"
                                                             data-bs-parent="#accordion-{{ block.id }}">
                                                            <div class="accordion-body rte rte-custom">
                                                                {{ block.settings.row_content3 }}
                                                                {{ block.settings.page.content3 }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                                {% if block.settings.heading4 != blank %}
                                                    <div class="accordion-item">
                                                        <h2 class="accordion-header">
                                                            <button class="accordion-button text-uppercase collapsed fs-15"
                                                                    type="button"
                                                                    data-bs-toggle="collapse"
                                                                    data-bs-target="#collapseFour"
                                                                    aria-expanded="true"
                                                                    aria-controls="collapseFour">
                                                                {{ block.settings.heading4 | default: block.settings.page.title4 }}
                                                            </button>
                                                        </h2>
                                                        <div id="collapseFour"
                                                             class="accordion-collapse collapse"
                                                             data-bs-parent="#accordion-{{ block.id }}">
                                                            <div class="accordion-body rte rte-custom">
                                                                {{ block.settings.row_content4 }}
                                                                {{ block.settings.page.content4 }}
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    {% when 'tab' %}
                                        {% if block.settings.style == 'style-2' %}
                                            <div
                                                    class="mb-{{ block.settings.margin_bottom }} mt-5 d-none d-md-block"
                                                    {{ block.shopify_attributes }}
                                            >
                                                <div class="ms-tab">
                                                    <ul class="nav nav-tabs"
                                                        role="tablist">
                                                        {% if block.settings.heading1 != blank %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link active" id="ms-tab1"
                                                                        data-bs-toggle="tab"
                                                                        data-bs-target="#ms-tab1-pane"
                                                                        type="button" role="tab"
                                                                        aria-controls="ms-tab1-pane"
                                                                        aria-selected="true">{{ block.settings.heading1 | default: block.settings.page.title1 }}</button>
                                                            </li>
                                                        {% endif %}
                                                        {% if block.settings.heading2 != blank %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" id="ms-tab2"
                                                                        data-bs-toggle="tab"
                                                                        data-bs-target="#ms-tab2-pane" type="button"
                                                                        role="tab"
                                                                        aria-controls="ms-tab2-pane"
                                                                        aria-selected="false">
                                                                    {{ block.settings.heading2 | default: block.settings.page.title2 }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if block.settings.heading3 != blank %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" id="ms-tab3"
                                                                        data-bs-toggle="tab"
                                                                        data-bs-target="#ms-tab3-pane" type="button"
                                                                        role="tab" aria-controls="ms-tab3-pane"
                                                                        aria-selected="false">
                                                                    {{ block.settings.heading3 | default: block.settings.page.title3 }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                        {% if block.settings.heading4 != blank %}
                                                            <li class="nav-item" role="presentation">
                                                                <button class="nav-link" id="ms-tab4"
                                                                        data-bs-toggle="tab"
                                                                        data-bs-target="#ms-tab4-pane" type="button"
                                                                        role="tab" aria-controls="ms-tab4-pane"
                                                                        aria-selected="false">
                                                                    {{ block.settings.heading4 | default: block.settings.page.title4 }}
                                                                </button>
                                                            </li>
                                                        {% endif %}
                                                    </ul>
                                                    <div class="tab-content" id="myTabContent">
                                                        {% if block.settings.heading1 != blank %}
                                                            <div class="tab-pane rte rte-custom fade show active" id="ms-tab1-pane"
                                                                 role="tabpanel"
                                                                 aria-labelledby="ms-tab1" tabindex="0">
                                                                {{ block.settings.row_content1 }}
                                                                {{ block.settings.page.content1 }}
                                                            </div>
                                                        {% endif %}
                                                        {% if block.settings.heading2 != blank %}
                                                            <div class="tab-pane rte rte-custom fade" id="ms-tab2-pane"
                                                                 role="tabpanel"
                                                                 aria-labelledby="ms-tab2" tabindex="0">
                                                                {{ block.settings.row_content2 }}
                                                                {{ block.settings.page.content2 }}
                                                            </div>
                                                        {% endif %}
                                                        {% if block.settings.heading3 != blank %}
                                                            <div class="tab-pane rte rte-custom fade" id="ms-tab3-pane"
                                                                 role="tabpanel"
                                                                 aria-labelledby="ms-tab3" tabindex="0">
                                                                {{ block.settings.row_content3 }}
                                                                {{ block.settings.page.content3 }}
                                                            </div>
                                                        {% endif %}
                                                        {% if block.settings.heading4 != blank %}
                                                            <div class="tab-pane rte rte-custom fade" id="ms-tab4-pane"
                                                                 role="tabpanel"
                                                                 aria-labelledby="ms-tab4" tabindex="0">
                                                                {{ block.settings.row_content4 }}
                                                                {{ block.settings.page.content4 }}
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        {% endif %}
                                    {% when 'description' %}
                                        <div
                                                class="d-none d-md-block rte rte-custom mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }}"
                                                {{ block.shopify_attributes }}
                                        >
                                            {% if block.settings.heading != '' %}
                                            <h3 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h3>
                                            {% endif %}
                                            {% if block.settings.enable_length %}
                                                <p class=" mb-0">{{ product.description | strip_html | truncatewords: block.settings.length }}</p>
                                            {% else %}
                                                {{ product.description }}
                                            {% endif %}
                                        </div>
                                {% endcase %}
                            {% endfor %}
                        </div>

                    </div>
                </div>
                <div class="col product-single__description {{ product_description_width }}">
                    <div class="product-single__meta {% if section.settings.enable_sticky_content %}sticky-md-top top-10{% endif %}">
                        <div class="content-inner">

                            {% for block in section.blocks %}
                                {% case block.type %}
                                    {% when '@app' %}
                                        {% render block %}
                                    {% when 'text' %}
                                        <p
                                                class="{% if block.settings.style == 'style-2' %} fs-14 mb-0 opacity-85 fst-italic font-monospace{% else %} fs-15{% endif %} mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }} rte"
                                                {{ block.shopify_attributes }}
                                        >
                                            {{ block.settings.text }}
                                        </p>
                                    {% when 'title' %}

                                        <div
                                                class="mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }}"
                                                {{ block.shopify_attributes }}
                                        >
                                            <div class="d-flex flex-wrap align-items-center">
                                                <h1 class="mb-0 {{ block.settings.heading_size }}">{{ product.title }}</h1>
                                            </div>

                                            <!-- Rating Badge below title -->
                                            <div class="zoopey-rating-badge d-inline-flex align-items-center mt-2">
                                                <span class="zoopey-rating-star">★</span>
                                                <span class="zoopey-rating-score">
                                                    {{ product.metafields.reviews.rating.value | default: '4.7' }}
                                                </span>
                                                <span class="zoopey-rating-divider">|</span>
                                                <span class="zoopey-rating-count">
                                                    {{ product.metafields.reviews.rating_count.value | default: '14,467' }}
                                                    ratings
                                                </span>
                                            </div>

                                            <style>
                                              .zoopey-rating-badge {
                                                border: 1.5px solid #d1d5db;
                                                border-radius: 8px;
                                                padding: 5px 14px;
                                                gap: 7px;
                                                background: #fff;
                                                font-family: inherit;
                                                cursor: default;
                                                user-select: none;
                                              }
                                              .zoopey-rating-star {
                                                color: #f5a623;
                                                font-size: 18px;
                                                line-height: 1;
                                              }
                                              .zoopey-rating-score {
                                                font-size: 15px;
                                                font-weight: 700;
                                                color: #111;
                                                line-height: 1;
                                              }
                                              .zoopey-rating-divider {
                                                color: #9ca3af;
                                                font-size: 15px;
                                                font-weight: 400;
                                                line-height: 1;
                                              }
                                              .zoopey-rating-count {
                                                font-size: 14px;
                                                font-weight: 400;
                                                color: #374151;
                                                line-height: 1;
                                              }
                                            </style>
                                        </div>
                                    {% when 'payment' %}
                                        <div
                                                class="mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }}"
                                                {{ block.shopify_attributes }}
                                        >
                                            <div class="position-relative text-center">
                                                {% if block.settings.heading != blank %}
                                                    <h3 class="fs-14 text-uppercase bg-body content-in-box">{{ block.settings.heading }}</h3>
                                                {% endif %}
                                                <ul class="payment-icons list--inline">
                                                    {% for type in shop.enabled_payment_types %}
                                                        <li class="payment-icon mx-1 mb-2">
                                                            {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        </div>
                                    {% when 'price' %}

                                        <div
                                                id="price-{{ section.id }}"
                                                class="mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }} border-bottom pb-3"
                                                {{ block.shopify_attributes }}
                                        >
                                            <!-- Urgency Stock Counter -->
                                            <div class="d-flex align-items-center gap-2 mb-2 px-2 py-1 rounded" style="background: #fff7ed; border: 1px solid #ffedd5; width: fit-content;">
                                                <span class="spinner-grow spinner-grow-sm text-danger" role="status" style="width: 8px; height: 8px;"></span>
                                                <span class="fw-bold fs-12 text-danger">🔥 Selling fast! Only <span class="fw-black">7 items</span> left in stock</span>
                                            </div>

                                            <div class="d-flex align-items-center justify-content-between flex-wrap">
                                                <div class="product__price style-large mb-0">
                                                    <div class="d-flex flex-nowrap align-items-center">
                                                        {% render 'product-price',
                                                                variant: current_variant,
                                                                show_vendor: false,
                                                                style: 'large',
                                                                show_badges: true
                                                        %}
                                                    </div>
                                                </div>
                                                {% if cart.taxes_included or shop.shipping_policy.body != blank %}
                                                    <div class="product__policies rte" data-product-policies>
                                                        {% if cart.taxes_included %}
                                                            {{ 'products.product.include_taxes' | t }}
                                                        {% endif %}
                                                        {% if shop.shipping_policy.body != blank %}
                                                            {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                                {% if block.settings.enable_rating_badge_stars %}
                                                    <div class="star-wrap">
                                                        <!-- Start of Judge.me code -->
                                                        <div class='jdgm-widget jdgm-preview-badge'>
                                                            {{ product.metafields.judgeme.badge }}
                                                        </div>
                                                        <!-- End of Judge.me code -->
                                                    </div>
                                                {% endif %}
                                            </div>

                                        </div>
                                    {% when 'product_form' %}
                                        <div
                                                class="{% if block.settings.picker_type == 'dropdown' %} style-dropdown {% endif %} mb-{{ block.settings.margin_bottom }} mt-{{ block.settings.margin_top }}"
                                                {{ block.shopify_attributes }}
                                        >
                                            {% assign product_form_id = 'product-form-' | append: section.id %}
                                            {% capture form_classes %}
                                                product-form product-form-{{ section.id }}
                                                {% if section.settings.enable_payment_button and product.has_only_default_variant %} product-form--payment-btn-no-variants {% endif %}
                                                {% if current_variant.available == false %} product-form--variant-sold-out {% endif %}
                                            {% endcapture %}
                                            <ajax-cart-product-form>
                                                {% form 'product', product, id: product_form_id, class: form_classes, novalidate: 'novalidate', data-product-form: '' %}
                                                    <input type="hidden" name="id" id="ProductFormVariantId-{{ section.id }}" value="{{ product.selected_or_first_available_variant.id }}">
                                                    {{ form | payment_terms }}
                                                    {% render 'product-variant-picker', product: product, block: block %}
                                                    <select name="id" id="ProductSelect-{{ section.id }}"
                                                            class="product-form__variants no-js">
                                                        {% for variant in product.variants %}
                                                            <option
                                                                    value="{{ variant.id }}"
                                                                    {% if variant == current_variant %}
                                                                        selected="selected"
                                                                    {% endif %}
                                                            >
                                                                {{ variant.title }}
                                                                {% if variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                                                            </option>
                                                        {% endfor %}
                                                    </select>
                                                    {% render 'custom-field', section: section, block: block %}
                                                    <div class="d-flex align-items-end">
                                                        {% if block.settings.show_quantity_selector %}
                                                            <div class="product-form__controls-group product-quantity">
                                                                <div class="product-form__item-2">
                                                                    <label>{{ 'products.product.quantity' | t }}</label>
                                                                    <div class="d-flex align-items-center flex-nowrap">
                                                                        <div class="quantity-selector d-flex">
                                                                            <button class="quantity__button disabled"
                                                                                    name="minus"
                                                                                    type="button"
                                                                                    onclick="updateQuantity(this, -1)"><i
                                                                                        class="bi bi-dash"></i>
                                                                            </button>
                                                                            <input
                                                                                    type="number"
                                                                                    name="quantity"
                                                                                    value="1"
                                                                                    class="product-form__input product-form__input--quantity"
                                                                                    data-quantity-input
                                                                            >
                                                                            <button class="quantity__button" name="plus"
                                                                                    type="button"
                                                                                    onclick="updateQuantity(this, 1)"><i
                                                                                        class="bi bi-plus"></i>
                                                                            </button>
                                                                        </div>

                                                                    </div>
                                                                </div>

                                                            </div>

                                                        {% endif %}
                                                        {%- if settings.enable_wishlist -%}
                                                            <div class="ms-3 mb-3 icon-btn">
                                                                {% render 'button-wishlist', product: product, text: 'show' %}
                                                            </div>
                                                        {%- endif -%}
                                                    </div>
                                                    <div
                                                            class="product-form__error-message-wrapper product-form__error-message-wrapper--hidden{% if block.settings.enable_payment_button %} product-form__error-message-wrapper--has-payment-button{% endif %}"
                                                            data-error-message-wrapper
                                                            role="alert"
                                                    >
                                                        <span class="d-none">{{ 'general.accessibility.error' | t }} </span>
                                                        <i class="bi bi-exclamation-circle"></i>
                                                        <span
                                                                class="product-form__error-message"
                                                                data-error-message
                                                        >
                        {{- 'products.product.quantity_minimum_message' | t -}}
                      </span>
                                                    </div>

                                                    <div class="product-form__controls-group product-form__controls-group--submit">
                                                        <div class="shiprocket-custom-btn-wrapper position-relative my-3 pt-2">
                                                            <!-- Top Green Prepaid Discount Badge -->
                                                            <div class="position-absolute start-0 top-0 translate-middle-y z-3 ms-2 px-3 py-1 rounded-1 fw-bold text-dark shadow-sm"
                                                                 style="background: #26e768; color: #000000 !important; font-weight: 800; letter-spacing: 0.2px; font-size: 11px;">
                                                                ⚡ Flat ₹300 OFF on Prepaid Orders
                                                            </div>
                                                            
                                                            <!-- Main Green Buy Now Button -->
                                                            <button type="button"
                                                                    class="shiprocket-green-btn btn w-100 border-0 text-white p-3 rounded-1 position-relative overflow-hidden cursor-pointer"
                                                                    {% if current_variant.available == false %} disabled="disabled"{% endif %}
                                                                    onclick="var form = this.closest('form'); var srBtn = form ? form.querySelector('.sr-headless-checkout, .cf-occ-btn, [data-type=product], .shopify-payment-button__button') : null; if(srBtn && srBtn !== this) { srBtn.click(); } else if (typeof shiprocketCheckoutEvents !== 'undefined') { shiprocketCheckoutEvents.buyProduct(event); } else if (typeof onBuyNowClick === 'function') { onBuyNowClick(event); } else if (form) { form.submit(); }"
                                                                    style="background: #288855; height: 56px; border-radius: 4px;">
                                                                <div class="d-flex align-items-center justify-content-between h-100 px-2">
                                                                    <!-- BUY NOW Text -->
                                                                    <div class="d-flex align-items-center gap-2">
                                                                        <span class="fw-black fs-18 text-white" style="font-weight: 900; letter-spacing: 1.2px;">BUY NOW</span>
                                                                    </div>
                                                                    
                                                                    <!-- Payment Method Badges (GPay, PhonePe 'पे', Paytm) -->
                                                                    <div class="d-flex align-items-center bg-white rounded-pill px-2 py-1 gap-1 shadow-sm ms-auto me-3" style="height: 32px;">
                                                                        <!-- GPay -->
