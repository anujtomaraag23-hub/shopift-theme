{% style %}
    {% if use_custom_colors_block %}
        .block-extras-color-{{ block_id }} {
        --gradient-background-block: {% if color_background_gradient_block != blank %}{{ color_background_gradient_block }}{% else %}{{ color_background_block }}{% endif %};
        --color-background-block: {{ color_background_block.red }}, {{ color_background_block.green }}, {{ color_background_block.blue }};
        --color-foreground-block: {{ color_text_block.red }}, {{ color_text_block.green }}, {{ color_text_block.blue }};
        }
    {% endif %}
    {% if use_overlay %}
        .card-overlay-{{ block_id }} {
        --color-overlay: {{ colors_overlay.red }}, {{ colors_overlay.green }}, {{ colors_overlay.blue }};
        --color-overlay-opacity: {{ overlay_opacity }};
        }
    {% endif %}
{% endstyle %}

<div
        class="cs-card card-banner card-banner-one hover-shine overflow-hidden {{ style }} {{ style_hover }}"
>
    <div
            class="clearfix position-relative card-img-custom-height {{ image_height_mobile }} h-image-custom"
    >
        <div class="card-img-top item-hover lh-0 d-block overflow-hidden{% if use_overlay %} card-overlay card-overlay-{{ block_id }}{% endif %}">

            {% if video_mobile != blank %}
                <div class="d-block d-md-none">
                    {{ video_mobile | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false }}
                </div>
            {% else %}
                {% if image_mobile != blank %}
                    <div class="d-block d-md-none">
                        {% render 'image', lazyload: true, image: image_mobile, class: 'w-100' %}
                    </div>
                {% endif %}
            {% endif %}

            {% if video != blank %}
                <div class="media-wrap {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                    {{ video | video_tag: image_size: '600x', autoplay: true, loop: true, muted: true, controls: false }}
                </div>
            {% else %}
                {% if image != blank %}
                    <div class="media-wrap {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                        {% render 'image-lg', lazyload: true, image: image, class: 'w-100' %}
                    </div>
                {% else %}
                    <div class="media-wrap {% if image_mobile != blank or video_mobile != blank %}d-none d-md-block{% endif %}">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg bg-body-tertiary' }}
                    </div>
                {% endif %}
            {% endif %}
        </div>
        <div class="animation-active {{ animation }} position-absolute start-50 top-50 translate-middle z-1 {{ text_box_position }} {{ text_alignment }} {{ text_alignment_mobile }}">
            <div class="cs-card-body-inner {% if color_background_block == "rgba(0,0,0,0)" and use_custom_colors_block %} py-4 px-0 {% else %}p-1{% endif %} {% if use_custom_colors_block %} block-extras-color block-extras-color-{{ block_id }}{% endif %}">
                <div class="card-top">
                    {% if preheading or heading or subheading %}
                        <div class="heading heading-wrap {{ class }} {{ heading_alignment_mobile }} {{ heading_alignment }}">
                            {% if preheading != blank %}
                                <h6 class="sub-1 preheading fs-14 mb-2 text-uppercase opacity-85"{% if animation != "off" %} data-aos="fade-up"{% endif %}>
                                    {{ preheading }}
                                </h6>
                            {% endif %}
                            {% if heading %}
                                {% render 'h-heading',
                                        heading: heading,
                                        heading_tag: heading_tag,
                                        heading_size: heading_size,
                                        animation: 'yes'
                                %}
                            {% endif %}
                            {% if subheading != blank %}
                                <div class="sub-3 subheading rte mb-0 mt-2 mt-lg-3 {{ subheading_class }}"{% if animation != "off" %} data-aos="fade-up" data-aos-delay="200"{% endif %}>
                                    {{ subheading }}
                                </div>
                            {% endif %}
                            {% if button_link and button_label != null %}
                                <div class="sub-4 card-bottom mt-5"{% if animation != "off" %} data-aos="fade-up" data-aos-delay="300"{% endif %}>
                                    <a
                                            {% if button_link == blank %}
                                                role="link" aria-disabled="true"
                                            {% else %}
                                                href="{{ button_link }}"
                                            {% endif %}
                                            class="btn btn-{{ button_style }} position-relative z-index-1"
                                    >
                                        <span>{{- button_label | escape -}}</span>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>
</div>
